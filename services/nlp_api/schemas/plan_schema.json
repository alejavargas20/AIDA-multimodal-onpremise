{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfm.local/schemas/plan_schema.json",
  "title": "PlannerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "confidence",
    "tasks",
    "metadata",
    "conductual_state",
    "conductual_notes"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "description": "Intención principal inferida de la petición del usuario.",
      "enum": [
        "consulta_datos",
        "analisis_financiero",
        "resumen",
        "explicacion",
        "comparacion",
        "recomendacion",
        "alerta_riesgo",
        "perfil_cliente",
        "procesar_documento",
        "ayuda",
        "otro"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confianza del planner sobre la intent (0 a 1)."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "description": "Lista de tareas que el orquestador ejecutará.",
      "items": { "$ref": "#/$defs/Task" }
    },
    "metadata": { "$ref": "#/$defs/Metadata" },
    "conductual_state": {
      "description": "Reservado para futura integración COM-B. En el MVP debe ser null.",
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "conductual_notes": {
      "description": "Reservado para futura integración COM-B. En el MVP debe ser null.",
      "type": ["string", "null"],
      "maxLength": 2000
    }
  },
  "$defs": {
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "input_source"],
      "properties": {
        "language": {
          "type": "string",
          "description": "Código de idioma (ISO-639-1). Ej: es, en.",
          "minLength": 2,
          "maxLength": 5
        },
        "input_source": {
          "type": "string",
          "description": "Origen de entrada ya normalizada por el pipeline previo.",
          "enum": ["chat", "stt", "ocr"]
        }
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "action", "input", "params"],
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["nlp", "data", "image", "voice"],
          "description": "Agente responsable de ejecutar la tarea."
        },
        "action": {
          "type": "string",
          "description": "Acción solicitada al agente.",
          "enum": [
            "preguntar_aclaracion",
            "responder",
            "resumir",
            "extraer_entidades",
            "consultar",
            "generar_reporte",
            "describir_imagen",
            "extraer_texto_documento",
            "transcribir_audio",
            "otro"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "Texto principal que describe qué debe hacer el agente."
        },
        "params": {
          "type": "object",
          "description": "Parámetros adicionales. No debe contener datos sensibles. Puede estar vacío.",
          "additionalProperties": true
        }
      }
    }
  }
}
